.{
    .name = .v8,
    .version = "0.0.0",
    .fingerprint = 0x10be7411eb47d7c5, // Changing this has security and trust implications.
    .minimum_zig_version = "0.15.2",
    .dependencies = .{
        // Local stub: full depot_tools fetch from chromium.googlesource.com is
        // unavailable on this network. Not needed when building with
        // -Dprebuilt_v8_path=... (bootstrapDepotTools is skipped).
        .depot_tools = .{
            .path = "depot_tools_stub",
        },
    },
    .paths = .{
        "src/",
        "build-tools/",
        "README",
        "LICENSE",
        "build.zig",
        "build.zig.zon",
    },
}
