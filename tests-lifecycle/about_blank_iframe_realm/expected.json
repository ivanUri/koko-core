{
  "must_contain": [
    "immediate:Object",
    "immediate:Function",
    "immediate:Object.prototype",
    "immediate:Function.prototype",
    "immediate:Function.prototype.toString",
    "immediate:Object.prototype.toString",
    "immediate:navigator",
    "immediate:document",
    "immediate:documentElement",
    "immediate:toString-call-ok",
    "immediate:object-toString-call-ok",
    "microtask:toString-call-ok",
    "detached:window-null"
  ],
  "must_not_contain": [
    "immediate:window-null",
    "microtask:window-null",
    "immediate:toString-call-error:TypeError",
    "immediate:object-toString-call-error:TypeError",
    "microtask:toString-call-error:TypeError",
    "microtask:object-toString-call-error:TypeError",
    "detached:window-present"
  ]
}
