# Prebuilt V8 archives (download per platform; do not commit ~100MB+)
/v8/*.a
/v8/*.so
/v8/*.dylib

# Linux curl-impersonate prebuilts (fetch via scripts/fetch-linux-curl-impersonate.sh)
/vendor/curl-impersonate/linux/libcurl-impersonate.a
/vendor/curl-impersonate/linux/libcurl-impersonate.so
/vendor/curl-impersonate/linux/libcurl-impersonate.so.*
/vendor/curl-impersonate/linux/libcurl-impersonate.runtime-probe.so
/vendor/curl-impersonate/linux/*.tar.gz
/vendor/curl-impersonate/linux/lib.tgz
velora.id
/src/html5ever/target/
src/snapshot.bin
*.bak
*.bak/
node_modules/.lp-cache/
.velora-cache
curl-impersonate/
node_modules

# Ephemeral probes / export dumps (do not accumulate in repo)
/artifacts/
/tmp/

logs-demo/
logs-test/
wpt/
google-search-debug/tmp/
Kameleo-decode/
*.log
diff.txt
.clinerules
/.grok
