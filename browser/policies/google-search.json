{
  "version": 1,
  "id": "google-search",
  "enabledWhen": "antidetect",
  "match": {
    "hostSuffix": ["google.com"],
    "pathContains": ["/search"]
  },
  "navigation": {
    "injectParam": {
      "name": "sei",
      "when": "address_bar_in_session"
    },
    "referer": "search_q_only",
    "priorOrigin": "https://www.google.com",
    "omitCookies": "never",
    "omitSecFetchUser": "in_session",
    "curlDefaultsOnly": "never",
    "externalTransport": {
      "configFlag": "google_chrome_transport",
      "when": "first_hop_or_query_contains",
      "queryContains": ["sg_ss="]
    }
  },
  "http": {
    "match": {
      "hostSuffix": ["google.com"]
    },
    "headerPlugin": "x-browser"
  }
}
