{
  "name": "velora",
  "private": true,
  "workspaces": [
    "sdk"
  ],
  "dependencies": {
    "@velora/sdk": "workspace:*",
    "playwright": "^1.60.0",
    "ws": "^8.21.0"
  },
  "scripts": {
    "build:sdk": "npm run build --workspace=@velora/sdk",
    "test:creepjs:compare": "node scripts/cdp-creepjs-compare.mjs",
    "test:creepjs:local": "node scripts/cdp-creepjs-local-probe.mjs",
    "test:creepjs:section": "node scripts/cdp-creepjs-section-compare.mjs",
    "test:creepjs:online": "node scripts/cdp-creepjs-online-compare.mjs",
    "test:creepjs:online:debug": "node scripts/cdp-creepjs-online-debug.mjs",
    "test:creepjs:timeout": "node scripts/cdp-creepjs-timeout-probe.mjs",
    "test:browserleaks": "node scripts/cdp-browserleaks-compare.mjs",
    "test:profile": "node scripts/cdp-profile-probe.mjs",
    "pretest:sdk:smoke": "npm run build:sdk",
    "test:sdk:smoke": "node scripts/sdk-smoke.mjs",
    "preexample:crawl": "npm run build:sdk",
    "example:crawl": "node sdk/examples/crawl-wikipedia.mjs --launch --limit 8 --concurrency 2",
    "preexample:agent": "npm run build:sdk",
    "example:agent": "node sdk/examples/agent-semantic.mjs --launch",
    "google:compare": "node google-search-debug/scripts/compare-search.mjs",
    "google:sorry-parity": "node google-search-debug/scripts/compare-sorry-parity.mjs",
    "google:trace": "node google-search-debug/scripts/trace-search.mjs",
    "google:probe": "node google-search-debug/scripts/probe-google-js.mjs",
    "google:probe-knitsail": "node google-search-debug/scripts/probe-knitsail.mjs",
    "prebench:compare": "npm run build:sdk",
    "bench:compare": "node code-check/bench/compare-runner.mjs",
    "bench:compare:report": "node code-check/bench/render-report.mjs",
    "bench:compare:publish": "npm run bench:compare && npm run bench:compare:report",
    "prebench:crawl:wikipedia": "npm run build:sdk",
    "bench:crawl:wikipedia": "node code-check/bench/crawl-wikipedia-compare.mjs",
    "bench:crawl:wikipedia:report": "node code-check/bench/render-crawl-report.mjs",
    "bench:crawl:wikipedia:publish": "npm run bench:crawl:wikipedia && npm run bench:crawl:wikipedia:report",
    "prebench:density:sweep": "npm run build:sdk",
    "bench:density:sweep": "node code-check/bench/density-sweep.mjs",
    "bench:density:report": "node code-check/bench/render-density-report.mjs",
    "bench:density:publish": "npm run bench:density:sweep && npm run bench:density:report",
    "prebench:google:agent": "npm run build:sdk",
    "bench:google:agent": "node code-check/bench/google-agent-compare.mjs",
    "bench:google:agent:report": "node code-check/bench/render-google-agent-report.mjs",
    "bench:google:agent:publish": "npm run bench:google:agent && npm run bench:google:agent:report",
    "prebench:suite": "npm run build:sdk",
    "bench:suite": "node scripts/benchmark-suite.mjs"
  }
}