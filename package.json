{
  "name": "velora",
  "private": true,
  "dependencies": {
    "playwright": "^1.60.0",
    "ws": "^8.21.0"
  },
  "scripts": {
    "test:profile": "node scripts/cdp-profile-probe.mjs",
    "bench:preflight": "node scripts/bench-preflight.mjs",
    "prebench:compare": "npm run bench:preflight",
    "bench:compare": "node code-check/bench/compare-runner.mjs",
    "bench:compare:report": "node code-check/bench/render-report.mjs",
    "bench:compare:publish": "npm run bench:compare && npm run bench:compare:report",
    "prebench:crawl:wikipedia": "npm run bench:preflight",
    "bench:crawl:wikipedia": "node code-check/bench/crawl-wikipedia-compare.mjs",
    "bench:crawl:wikipedia:density": "node code-check/bench/crawl-wikipedia-compare.mjs --lane density",
    "bench:crawl:wikipedia:fair": "node code-check/bench/crawl-wikipedia-compare.mjs --lane fair",
    "bench:crawl:wikipedia:report": "node code-check/bench/render-crawl-report.mjs",
    "bench:crawl:wikipedia:density:report": "node code-check/bench/render-crawl-report.mjs --input code-check/tmp/benchmarks/crawl-wikipedia.json --output-prefix crawl-wikipedia",
    "bench:crawl:wikipedia:fair:report": "node code-check/bench/render-crawl-report.mjs --input code-check/tmp/benchmarks/crawl-wikipedia-fair.json --output-prefix crawl-wikipedia-fair",
    "bench:crawl:wikipedia:publish": "npm run bench:crawl:wikipedia:density:publish",
    "bench:crawl:wikipedia:density:publish": "npm run bench:crawl:wikipedia:density && npm run bench:crawl:wikipedia:density:report",
    "bench:crawl:wikipedia:fair:publish": "npm run bench:crawl:wikipedia:fair && npm run bench:crawl:wikipedia:fair:report",
    "bench:crawl:wikipedia:publish:all": "npm run bench:crawl:wikipedia:density:publish && npm run bench:crawl:wikipedia:fair:publish",
    "prebench:density:sweep": "npm run bench:preflight",
    "bench:density:sweep": "node code-check/bench/density-sweep.mjs",
    "bench:density:report": "node code-check/bench/render-density-report.mjs",
    "bench:density:publish": "npm run bench:density:sweep && npm run bench:density:report",
    "prebench:google:agent": "npm run bench:preflight",
    "bench:google:agent": "node code-check/bench/google-agent-compare.mjs",
    "bench:google:agent:report": "node code-check/bench/render-google-agent-report.mjs",
    "bench:google:agent:publish": "npm run bench:google:agent && npm run bench:google:agent:report",
    "site:stability": "node code-check/site-stability/run.mjs",
    "site:stability:quick": "node code-check/site-stability/run.mjs --site example,wikipedia,github,hn --repeats 2",
    "site:stability:stress": "node code-check/site-stability/stress-renavigate.mjs",
    "bench:live-sites": "node code-check/bench/live-sites-perf.mjs",
    "prebench:live-sites": "npm run bench:preflight"
  }
}