{
  "dependencies": {
    "playwright": "^1.60.0",
    "ws": "^8.21.0"
  },
  "scripts": {
    "test:fingerprint": "node code-check/suite/runner.mjs",
    "test:fingerprint:remote": "node code-check/suite/runner.mjs --remote",
    "test:fingerprint:browserleaks": "node code-check/suite/runner.mjs --browserleaks",
    "test:fingerprint:full": "node code-check/suite/runner.mjs --remote --scripts",
    "test:fingerprint:compare": "node code-check/suite/runner.mjs --compare-browser",
    "test:site:fingerprint": "node code-check/sites/fingerprint/playground.mjs",
    "test:site:google": "node code-check/sites/google/search.mjs",
    "test:site:tiktok": "node code-check/sites/tiktok/visit.mjs",
    "test:site:tiktok:profile": "node code-check/sites/tiktok/profile.mjs",
    "test:site:recaptcha": "node code-check/sites/recaptcha/demo.mjs",
    "test:site:recaptcha:score": "node code-check/sites/recaptcha/score-detector.mjs",
    "test:site:recaptcha:appspot": "node code-check/sites/recaptcha/appspot-v3-scores.mjs",
    "test:site:browserscan": "node code-check/sites/browserscan/scan.mjs",
    "test:feature:webgl": "node code-check/features/webgl/worker.mjs",
    "test:feature:worker": "node code-check/features/worker/simple.mjs",
    "test:lifecycle": "node code-check/lifecycle/runner.js",
    "test:lifecycle:chrome": "node code-check/lifecycle/runner-chrome.js",
    "bench:velora-test": "node code-check/bench/velora-test-runner.mjs",
    "bench:compare": "node code-check/bench/compare-runner.mjs",
    "bench:compare:report": "node code-check/bench/render-report.mjs",
    "bench:compare:publish": "npm run bench:compare && npm run bench:compare:report",
    "bench:crawl:wikipedia": "node code-check/bench/crawl-wikipedia-compare.mjs",
    "bench:crawl:wikipedia:report": "node code-check/bench/render-crawl-report.mjs",
    "bench:crawl:wikipedia:publish": "npm run bench:crawl:wikipedia && npm run bench:crawl:wikipedia:report",
    "bench:crawl:hn": "node code-check/bench/crawl-hn-compare.mjs",
    "bench:crawl:hn:report": "node code-check/bench/render-crawl-report.mjs --input code-check/tmp/benchmarks/crawl-hn.json --output-prefix crawl-hn",
    "bench:crawl:hn:publish": "npm run bench:crawl:hn && npm run bench:crawl:hn:report"
  }
}